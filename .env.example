# Environment variables (copy this to .env.local)

# Convex deployment URL (get from Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=your-convex-url-here

# Google AI API Key (set in Convex dashboard using: npx convex env set GOOGLE_GENERATIVE_AI_API_KEY your-key)
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
